// Self-hosted (bot-side) global config. Every repo's own .github/workflows/renovate.yaml
// (github-workflows' reusable renovate.yaml) checks this file out from main and runs
// Renovate with it, pinned to that one repo; the manual org-wide fallback in
// .github/workflows/renovate-org.yaml reads it as-is. Repo-facing policy lives in
// default.json5; this file holds the options that only make sense for the bot itself.
{
  // every repo inherits the shared preset; no per-repo onboarding file needed. The
  // filename is explicit because Renovate only auto-discovers `default.json` for a bare
  // github>owner/repo reference (deliberately, to avoid try/fail API calls — see
  // renovate#36877); keeping JSON5 keeps the preset's comments.
  extends: ["github>bitwise-media-group/renovate-config:default.json5"],
  onboarding: false,
  requireConfig: "optional",
  // App installation token → API-created, GitHub-verified commits, which is what satisfies
  // the org's required_signatures ruleset. "auto" would detect this too; pinned explicitly
  // because the signature guarantee is load-bearing.
  platformCommit: "enabled",
  // mise updates shell out to mise: the manager's artifact step regenerates
  // mise.lock (`mise lock`) after an exact-pin bump, and the preset's transitional
  // lockFileMaintenance runs `mise lock --bump` for repos still on "latest"
  // selectors
  allowedUnsafeExecutions: ["mise"],
  // postUpgradeTasks allow-list — the execution boundary for repo-supplied commands;
  // anchored exact matches, widen only deliberately. Two org patterns run through it:
  //  - dist rebuild: JS action repos that commit their rollup bundle (ff-merge,
  //    setup-evolve, …) declare a postUpgradeTasks rule in their own
  //    .github/renovate.json5 to rebuild dist/ after npm bumps;
  //  - terraform docs regen: the preset runs `mise run docs` in terraform-* module repos
  //    after provider/module constraint bumps so the terraform-docs README blocks (which
  //    embed the constraints, and whose lint check would otherwise go stale-red) are
  //    refreshed in the same PR.
  allowedCommands: [
    "^npm ci --ignore-scripts$",
    "^npm run build$",
    "^mise run docs$",
  ],
  // TRANSITIONAL (goes with the preset's lockFileMaintenance): mise's own release
  // cooldown for `mise lock --bump` selector resolution (3d, matching the preset's
  // minimumReleaseAge). Exact pins resolve regardless of age, so this is inert for
  // pin-bump artifact runs.
  customEnvVariables: { MISE_MINIMUM_RELEASE_AGE: "3d" },
  // mise.toml's task_config in consumer repos includes .mise/common/tasks.toml (and
  // .mise/archetypes/<lang>/tasks.toml) from the toolchain submodule; without the clone
  // `mise lock` fails. The submodule's contents are
  // excluded from dependency scanning by ignorePaths in the preset.
  cloneSubmodules: true,
  // Only the org-wide fallback (renovate-org.yaml) autodiscovers: the per-repo runs
  // override both settings from the environment (RENOVATE_AUTODISCOVER=false,
  // RENOVATE_REPOSITORIES=<the caller>). For the fallback, scope is bounded by the App
  // INSTALLATION, not this filter.
  autodiscover: true,
  autodiscoverFilter: ["bitwise-media-group/*"],
}
